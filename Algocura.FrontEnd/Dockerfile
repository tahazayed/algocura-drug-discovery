FROM node:22-alpine AS build

WORKDIR /app

COPY Algocura.FrontEnd/package*.json ./

RUN --mount=type=cache,id=algocura-npm,target=/root/.npm \
    npm ci

COPY Algocura.FrontEnd/. ./

ARG VITE_IDENTITY_API_URL
ARG VITE_LITERATURE_API_URL
ARG VITE_TARGET_DISCOVERY_API_URL
ARG VITE_CHEMICAL_DESIGN_API_URL
ARG VITE_COMPOUND_CATALOG_API_URL
ARG VITE_SCREENING_API_URL
ARG VITE_ASSAY_MANAGEMENT_API_URL
ARG VITE_AI_DISCOVERY_API_URL
ARG VITE_WORKFLOW_API_URL
ARG VITE_NOTIFICATION_API_URL
ARG VITE_SEARCH_API_URL
ARG VITE_REPORTING_API_URL
ARG VITE_AUDIT_API_URL
ARG VITE_CLINICAL_RESEARCH_API_URL

ENV VITE_IDENTITY_API_URL=$VITE_IDENTITY_API_URL \
    VITE_LITERATURE_API_URL=$VITE_LITERATURE_API_URL \
    VITE_TARGET_DISCOVERY_API_URL=$VITE_TARGET_DISCOVERY_API_URL \
    VITE_CHEMICAL_DESIGN_API_URL=$VITE_CHEMICAL_DESIGN_API_URL \
    VITE_COMPOUND_CATALOG_API_URL=$VITE_COMPOUND_CATALOG_API_URL \
    VITE_SCREENING_API_URL=$VITE_SCREENING_API_URL \
    VITE_ASSAY_MANAGEMENT_API_URL=$VITE_ASSAY_MANAGEMENT_API_URL \
    VITE_AI_DISCOVERY_API_URL=$VITE_AI_DISCOVERY_API_URL \
    VITE_WORKFLOW_API_URL=$VITE_WORKFLOW_API_URL \
    VITE_NOTIFICATION_API_URL=$VITE_NOTIFICATION_API_URL \
    VITE_SEARCH_API_URL=$VITE_SEARCH_API_URL \
    VITE_REPORTING_API_URL=$VITE_REPORTING_API_URL \
    VITE_AUDIT_API_URL=$VITE_AUDIT_API_URL \
    VITE_CLINICAL_RESEARCH_API_URL=$VITE_CLINICAL_RESEARCH_API_URL

RUN npm run build

FROM nginx:1.29-alpine AS final

COPY Algocura.FrontEnd/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
